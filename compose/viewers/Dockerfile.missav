FROM golang:1.26-bookworm AS builder
WORKDIR /src
COPY dashboard/go.mod dashboard/go.sum ./
RUN go mod download
COPY dashboard/ ./
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/missav-viewer .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/missav-viewer /app/dashboard/missav-viewer
COPY dashboard/web /app/dashboard/web
COPY missav.db /app/missav.db
WORKDIR /app/dashboard
EXPOSE 8788
CMD ["/app/dashboard/missav-viewer"]
