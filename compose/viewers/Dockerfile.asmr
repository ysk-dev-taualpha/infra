FROM golang:1.26-bookworm AS builder
WORKDIR /src
COPY dashboard/go.mod dashboard/go.sum ./
RUN go mod download
COPY dashboard/ ./
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/asmr-viewer .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/asmr-viewer /app/dashboard/asmr-viewer
COPY dashboard/web /app/dashboard/web
COPY asmr.db /app/asmr.db
WORKDIR /app/dashboard
EXPOSE 8787
CMD ["/app/dashboard/asmr-viewer"]
